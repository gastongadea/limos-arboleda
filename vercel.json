{
  "version": 2,
  "framework": "create-react-app",
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/import-from-sheets",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/sync-sheets",
      "schedule": "0 9 * * *"
    }
  ]
}
